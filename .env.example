# --- required -------------------------------------------------------------

# The film page to watch (Traumpalast Leonberg, "Die Odyssee" as an example).
TARGET_URL=https://leonberg.traumpalast.de/index.php/FN/8415/PID/5574.html

# --- where to send alerts (at least one is required) ------------------------

# Discord channel settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# ntfy.sh: install the app, subscribe to a topic, put the topic here. Topics
# are PUBLIC to anyone who knows the name, so use a long random one.
# Watched-date alerts go out at max priority and tap through to the ticket page.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# --- which screening version to watch --------------------------------------

# Must match the heading on the page exactly. "IMAX" + "Deutsch" is the German
# IMAX version; use "IMAX (Originalversion)" + "Originalsprache" for the
# English one. Leave VERSION_LANGUAGE empty to ignore the language line.
VERSION_TITLE=IMAX
VERSION_LANGUAGE=Deutsch

# --- the dates you actually want ------------------------------------------

# Comma-separated. These get their own alert, separate from the general
# "new showtimes" message, so they are impossible to miss. Accepts
# 16.08.2026 or 2026-08-16. Leave empty to treat all dates the same.
WATCH_DATES=16.08.2026,22.08.2026,23.08.2026

# Prepended to watched-date alerts only, so your phone pushes even when the
# channel is set to "Only @mentions". Use @everyone, @here, or <@your-user-id>.
MENTION=@everyone

# --- optional --------------------------------------------------------------

# Seconds between checks (minimum 15). New showtimes usually appear on Monday.
CHECK_INTERVAL=120

# Where to remember the showtimes already announced.
STATE_FILE=state.json

# Touched after every successful check; the Docker healthcheck reads it.
# Leave empty to disable.
HEALTH_FILE=

# Post a summary of what is currently listed when the watcher starts.
NOTIFY_ON_START=true

# Also report when a sold-out showtime becomes bookable again.
NOTIFY_SOLD_OUT_CHANGES=true

# Warn on Discord after this many consecutive failed checks.
FAILURE_ALERT_AFTER=3

# Cap for the exponential backoff after failures, in seconds.
MAX_BACKOFF=1800

# HTTP request timeout in seconds, and retries per request.
REQUEST_TIMEOUT=20
HTTP_RETRIES=3

# Send a "still alive" message every N hours (0 disables it).
HEARTBEAT_HOURS=0
